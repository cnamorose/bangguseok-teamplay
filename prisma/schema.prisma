// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  mode      String   @default("study") // 마지막으로 있던 방 (study | career)
  tokenVersion Int   @default(0) // 로그아웃 시 +1 → 발급된 모든 JWT 무효화
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assemblies Assembly[]
  results    Result[]
  evaluations Evaluation[]
  companies    Company[]
  applications Application[]
  experiences  Experience[]
  interviews   Interview[]
  shares       Share[]
  comments     Comment[]
}

model Assembly {
  id        String   @id @default(uuid())
  userId    String
  name      String

  searchPersona    String
  generatePersona  String
  organizePersona  String
  visualizePersona String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results Result[]

  @@index([userId])
}

model Result {
  id         String   @id @default(uuid())
  assemblyId String?  // 취업방은 팀을 조립하지 않으므로 없을 수 있다
  userId     String
  mode       String   @default("study")   // 어느 방에서 만들었나 (study | career)
  kind       String   @default("article") // article | company | essay | interview
  topic      String
  resultData Json?
  filePath   String?
  /**
   * 책장에서 사용자가 고른 인덱스 탭 색 ("book-1" ~ "book-6").
   * 색 이름이 아니라 자리 이름을 담는다 — 테마가 바뀌면 색도 같이 따라가야 한다.
   * null이면 id에서 뽑아 쓴다 (지정 안 해도 서로 다른 색이 나오게)
   */
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assembly  Assembly?  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentLogs AgentLog[]

  @@index([userId, mode, createdAt(sort: Desc)]) // 책장 목록
  @@index([assemblyId])
}

model AgentLog {
  id          String    @id @default(uuid())
  resultId    String
  stage       String
  persona     String
  status      String    @default("pending")
  error       String?   // 실패했을 때 사유 (성공이면 null)
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  result   Result     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  apiUsage ApiUsage[]

  @@index([resultId, startedAt])
}

model ApiUsage {
  id         String   @id @default(uuid())
  agentLogId String
  provider   String
  tokensIn   Int?
  tokensOut  Int?
  cost       Decimal  @default(0)
  createdAt  DateTime @default(now())

  agentLog AgentLog @relation(fields: [agentLogId], references: [id], onDelete: Cascade)

  @@index([agentLogId])
}

// ── 취업방 ──
//
// 기업 분석은 두 단계로 나뉜다.
//   1차(회사 레벨) → Company.analysis   : 정체·흐름·경쟁·언어. 직무를 바꿔도 그대로다.
//   2차(직무 레벨) → Application.roleAnalysis : 직무·접점. 직무마다 다시 뽑아야 한다.
// 이렇게 나눠야 한 회사를 여러 직무로 볼 때 회사 정보를 다시 긁지 않는다.

// 취업방의 재료 창고. 회사가 늘 때마다 여기서 꺼내 쓰므로,
// 공부방의 Assembly(팀 구성)에 해당하는 이 방의 핵심 자산이다.
//
// 흐름: 막 적은 원문(raw) → 정리 도우미(LLM 1회) → 항목별 칸 + 태그 + 부족한 점(gaps)
// 원문을 남기는 이유는 LLM이 놓친 게 거기에만 있을 수 있고, 다시 정리할 수도 있어서다.
model Experience {
  id        String   @id @default(uuid())
  userId    String

  raw       String?  // 사용자가 막 적은 원문
  title     String   // 경험 이름 — 유일한 필수 (제목만 적고 저장할 수 있어야 한다)
  period    String?  // "2025.03~08", "2학년 여름" 같은 자유 표기가 실제로 더 많다
  role      String?  // 내 역할
  situation String?  // 상황 · 문제
  action    String?  // 행동 — 팀이 아니라 내가 직접 한 일
  impact    String?  // 결과 — 무엇이 달라졌나
  learning  String?  // 배운 점
  message   String?  // 이 경험이 말하는 한 가지 (문항 매칭의 기준)
  tags      String[] // 키워드 — 정리 도우미가 제안

  // LLM만 판정할 수 있는 부족한 점. [{ field, issue, question }]
  // 칸이 비었는지 같은 기계적 판정은 저장하지 않고 화면에서 계산한다.
  gaps        Json?
  organizedAt DateTime? // 마지막으로 정리 도우미를 돌린 시각

  starred   Boolean  @default(false) // 핵심 경험으로 골라둔 것
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, starred(sort: Desc), updatedAt(sort: Desc)])
}

model Company {
  id           String    @id @default(uuid())
  userId       String
  name         String
  analysis     Json?     // 회사 레벨 분석. 재분석하면 통째로 갈아끼운다
  analyzedAt   DateTime?
  lastResultId String?   // 이 분석을 만든 실행
  notes        String?   // 내 메모 (설명회·현직자 얘기 등) — 재분석해도 보존한다
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
}

// 회사 × 직무. 직무를 입력하는 순간 만들어지고, 나중에 자소서·면접이 여기 붙는다.
// deadline·status·pinned는 지원 관리를 켤 때 쓰는 칸이라 지금은 비워둔다.
model Application {
  id           String    @id @default(uuid())
  userId       String
  companyId    String
  role         String    // 직무
  // 채용공고 원문. 있으면 자격요건·마감일을 추측하지 않고 여기서 그대로 뽑는다.
  // (공고가 아직 안 뜬 회사도 준비할 수 있어야 하므로 없어도 된다)
  jobPosting   String?
  roleAnalysis Json?     // 공고 분석 결과
  analyzedAt   DateTime?
  lastResultId String?
  deadline     DateTime?
  status       String    @default("preparing") // preparing | submitted | doc_pass | interview | closed
  pinned       Boolean   @default(false)
  /** 책상에서 고른 인덱스 탭 색 ("book-1" ~ "book-6"). Result.color와 같은 규칙 */
  color        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  essays     Essay[]
  interviews Interview[]

  @@unique([companyId, role])
  @@index([userId, pinned(sort: Desc), deadline]) // 책상 기본 정렬
  @@index([userId, status])
  @@index([companyId])
}

// 자소서 문항 하나 + 그 답변.
// 문항마다 요구하는 게 달라서 kind를 들고 있고, 그 값이 프롬프트의 지시를 바꾼다.
// 초안을 뽑으면 곧바로 여기 저장된다(자동 저장). 이전 답변은 history에 쌓인다.
model Essay {
  id            String   @id @default(uuid())
  applicationId String
  order         Int      @default(0)

  prompt   String   // 문항 (사용자가 적는다)
  kind     String   @default("free") // motivation | competency | growth | teamwork | failure | future | free
  maxChars Int?     // 글자수 제한

  content   String   @default("")
  charCount Int      @default(0)

  history   Json[]   // 이전 답변들 (되돌리기용)
  questions Json?    // 초안을 쓰며 되물은 것 — 채워지면 다시 뽑을 때 반영된다
  usedExpIds String[] // 이 문항에 쓴 경험. 같은 경험을 여러 문항에 반복하는 걸 막는 데 쓴다
  resultId  String?  // 이 답변을 만든 실행

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, order])
}

// 면접 1회. 대화는 통째로 읽고 통째로 쓰므로 turns를 Json으로 둔다.
//
// 텍스트로 하되 실전 감각을 위해 답변 시간을 재고, 제출한 답변은 고칠 수 없다.
// (나중에 음성을 붙여도 STT 결과가 같은 자리에 들어가므로 이 모양은 안 바뀐다)
model Interview {
  id            String   @id @default(uuid())
  userId        String
  applicationId String?  // 회사 무관 연습이면 null

  // 고른 면접관 (lib/agents/interview/interviewers.ts의 id)
  interviewerIds String[]
  // 총 답변 횟수. 꼬리질문도 답을 해야 하므로 '몇 번 답하는가'로 센다
  maxTurns      Int      @default(8)

  // { role: "interviewer"|"candidate", speaker?, content, seconds?, over? }
  turns    Json[]
  feedback Json?    // 끝나고 받은 총평
  status   String   @default("running") // running | done

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([applicationId])
}

// ── 거실: 공유와 댓글 ──
//
// 공유할 수 있는 건 '결과물'뿐이다 (공부방 책 · 자소서 문항).
// 경험·기업분석·면접은 사적인 재료라 공유 대상이 아니다.
//
// 원본을 라이브로 읽지 않고 공유 시점의 스냅샷을 저장한다.
// 그래야 (1) 나중에 원본에 필드가 늘어도 새지 않고
//      (2) 원본을 고쳐도 남이 보던 내용이 갑자기 바뀌지 않는다.
model Share {
  id       String @id @default(uuid())
  token    String @unique // 주소에 쓰는 키
  ownerId  String
  kind     String // result | essay
  targetId String

  /** 공개할 내용만 담긴 스냅샷 (lib/share/snapshot.ts가 만든다) */
  snapshot Json
  /** link = 주소를 아는 사람 / login = 로그인한 사람만 */
  scope    String  @default("link")
  /**
   * 거실에 내놓았나. 켠 것만 남의 눈에 띈다.
   * scope와 따로 두는 이유: "링크를 아는 사람은 봐도 된다"와
   * "모두에게 보이는 자리에 올린다"는 다른 결정이다.
   * 링크만 주고 싶었던 글이 목록에 뜨면 사고다.
   */
  listed   Boolean @default(false)
  revoked  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([kind, targetId])
  @@index([listed, revoked, createdAt(sort: Desc)]) // 거실 피드
}

// 공유된 결과물에 다는 댓글. 익명은 받지 않는다 (신고·차단 문제를 키운다)
model Comment {
  id      String @id @default(uuid())
  shareId String
  userId  String
  content String

  createdAt DateTime @default(now())

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareId, createdAt])
}

model Evaluation {
  id         String   @id @default(uuid())
  userId     String
  mode       String   @default("study") // 어느 방에서 받은 평가인가
  topic      String
  text       String
  results    Json?
  revised    String?  // 논의 후 수정본 (있을 때만)
  targetType String?  // 무엇을 평가했나 (essay | interview). 낱장 평가면 null
  targetId   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}