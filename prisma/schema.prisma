// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  theme     String?  // 책장 테마 (StoredTheme JSON 문자열)
  mode      String   @default("study") // 마지막으로 있던 방 (study | career)
  tokenVersion Int   @default(0) // 로그아웃 시 +1 → 발급된 모든 JWT 무효화
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assemblies Assembly[]
  results    Result[]
  evaluations Evaluation[]
  companies    Company[]
  applications Application[]
}

model Assembly {
  id        String   @id @default(uuid())
  userId    String
  name      String

  searchPersona    String
  generatePersona  String
  organizePersona  String
  visualizePersona String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results Result[]

  @@index([userId])
}

model Result {
  id         String   @id @default(uuid())
  assemblyId String?  // 취업방은 팀을 조립하지 않으므로 없을 수 있다
  userId     String
  mode       String   @default("study")   // 어느 방에서 만들었나 (study | career)
  kind       String   @default("article") // article | company | essay | interview
  topic      String
  resultData Json?
  filePath   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assembly  Assembly?  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentLogs AgentLog[]

  @@index([userId, mode, createdAt(sort: Desc)]) // 책장 목록
  @@index([assemblyId])
}

model AgentLog {
  id          String    @id @default(uuid())
  resultId    String
  stage       String
  persona     String
  status      String    @default("pending")
  error       String?   // 실패했을 때 사유 (성공이면 null)
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  result   Result     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  apiUsage ApiUsage[]

  @@index([resultId, startedAt])
}

model ApiUsage {
  id         String   @id @default(uuid())
  agentLogId String
  provider   String
  tokensIn   Int?
  tokensOut  Int?
  cost       Decimal  @default(0)
  createdAt  DateTime @default(now())

  agentLog AgentLog @relation(fields: [agentLogId], references: [id], onDelete: Cascade)

  @@index([agentLogId])
}

// ── 취업방 ──
//
// 기업 분석은 두 단계로 나뉜다.
//   1차(회사 레벨) → Company.analysis   : 정체·흐름·경쟁·언어. 직무를 바꿔도 그대로다.
//   2차(직무 레벨) → Application.roleAnalysis : 직무·접점. 직무마다 다시 뽑아야 한다.
// 이렇게 나눠야 한 회사를 여러 직무로 볼 때 회사 정보를 다시 긁지 않는다.

model Company {
  id           String    @id @default(uuid())
  userId       String
  name         String
  analysis     Json?     // 회사 레벨 분석. 재분석하면 통째로 갈아끼운다
  analyzedAt   DateTime?
  lastResultId String?   // 이 분석을 만든 실행
  notes        String?   // 내 메모 (설명회·현직자 얘기 등) — 재분석해도 보존한다
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
}

// 회사 × 직무. 직무를 입력하는 순간 만들어지고, 나중에 자소서·면접이 여기 붙는다.
// deadline·status·pinned는 지원 관리를 켤 때 쓰는 칸이라 지금은 비워둔다.
model Application {
  id           String    @id @default(uuid())
  userId       String
  companyId    String
  role         String    // 직무
  roleAnalysis Json?     // 직무 레벨 분석 (직무·접점)
  analyzedAt   DateTime?
  lastResultId String?
  deadline     DateTime?
  status       String    @default("preparing") // preparing | submitted | doc_pass | interview | closed
  pinned       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role])
  @@index([userId, pinned(sort: Desc), deadline]) // 책상 기본 정렬
  @@index([userId, status])
  @@index([companyId])
}

model Evaluation {
  id         String   @id @default(uuid())
  userId     String
  mode       String   @default("study") // 어느 방에서 받은 평가인가
  topic      String
  text       String
  results    Json?
  revised    String?  // 논의 후 수정본 (있을 때만)
  targetType String?  // 무엇을 평가했나 (essay | interview). 낱장 평가면 null
  targetId   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}