# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요.
#   cp .env.example .env

# docker compose로 띄운 로컬 Postgres 기본값 그대로 쓰면 됩니다.
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/bangguseok?schema=public"

# 로그인 토큰 서명용. 아무 긴 임의 문자열이면 됩니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# 아래 두 키가 없어도 서버는 뜨고 회원가입·화면 둘러보기는 됩니다.
# 글 생성, 기업 분석, 첨삭, 면접 같은 AI 기능에만 필요합니다.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# https://app.tavily.com (무료 플랜 있음)
TAVILY_API_KEY=""
